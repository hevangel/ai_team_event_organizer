# Copy to .env and adjust. All values are optional — the app runs fine
# in testing mode without any of these.

# --- Login -------------------------------------------------------------------
# TESTING_MODE=true lets anyone sign in by typing a userid (trusted, no password).
# Set to false once Okta SSO is configured.
TESTING_MODE=true

# --- Okta SSO (OIDC authorization code flow) ---------------------------------
# OKTA_DOMAIN=https://dev-12345678.okta.com
# OKTA_CLIENT_ID=your-client-id
# OKTA_CLIENT_SECRET=your-client-secret
# Public base URL of the app; the Okta redirect URI becomes {BASE_URL}/api/auth/okta/callback.
# Add that redirect URI to the Okta app's "Sign-in redirect URIs".
BASE_URL=http://localhost:8000

# --- Google Maps (optional) --------------------------------------------------
# Needed for the office/venue map picker. The key needs "Maps JavaScript API"
# and "Places API" enabled. Can also be set at runtime in the admin panel
# (which overrides this env var).
# GOOGLE_MAPS_API_KEY=

# --- Server ------------------------------------------------------------------
# DB_PATH=backend/data/event_organizer.db

# Display-only override for the login-page MCP setup hints (CLI flags
# --mcp-hostname / --mcp-port / --mcp-subpath do the same). Empty = the
# login page derives the URL from the address the browser is on.
# MCP_PUBLIC_HOSTNAME=events.example.com
# MCP_PUBLIC_PORT=443
# MCP_PUBLIC_SUBPATH=team
